# PostgreSQL Database
DATABASE_URL=postgres://pacs:pacs_secret@localhost:5433/pacs_rayos_x

# JWT Authentication
JWT_SECRET=pacs-rayos-x-mindray-2026-secret-key

# Orthanc DICOM Server
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=orthanc
ORTHANC_PASS=pacs_secure_2026

# Webhook (for automatic study detection)
WEBHOOK_SECRET=pacs-webhook-secret-2026

# Server
PORT=3000
NODE_ENV=development

# Almacenamiento local en disco del PC, organizado por paciente
# Local Windows: C:/MiniPACS/estudios
# Docker (contenedor): /data/estudios (montar volumen C:/MiniPACS/estudios:/data/estudios)
LOCAL_STORAGE_PATH=C:/MiniPACS/estudios
